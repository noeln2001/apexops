# ApexOps Environment Configuration Template
PROJECT_NAME="ApexOps — Motorsport Technology & Intelligence Platform"
ENVIRONMENT="development"
REFERENCE_DATE="2026-10-20"

# Database Configuration
# Local development default: SQLite
DATABASE_URL="sqlite:///./data/apexops.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://apexops_admin:secure_password@localhost:5432/apexops"

# Security & Authentication
SECRET_KEY="replace_with_a_secure_32_character_random_hex_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"
ADMIN_EMAIL="admin@apexops.internal"
ADMIN_PASSWORD="replace_with_a_strong_admin_password"

# CORS Configuration
CORS_ORIGINS="http://localhost:5173,https://noeln2001.github.io"

# PostgreSQL Credentials (when running via docker-compose)
POSTGRES_DB="apexops"
POSTGRES_USER="apexops_admin"
POSTGRES_PASSWORD="replace_with_a_secure_db_password"

# External APIs
JOLPICA_BASE_URL="https://api.jolpi.ca/ergast/f1"
OPENF1_BASE_URL="https://api.openf1.org/v1"

# Storage Directories
BACKUP_DIR="./backups"
CACHE_DIR="./cache"
